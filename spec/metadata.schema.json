{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://waybill.dev/schemas/metadata.schema.json",
  "title": "Waybill Metadata",
  "description": "Metadata for a Waybill Bundle.",
  "type": "object",
  "required": ["schema_version", "source_agent", "created_at", "repo_root", "git", "artifacts"],
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.2",
      "description": "The Waybill Bundle schema version. This schema describes the current 0.2 format."
    },
    "source_agent": {
      "type": "string",
      "description": "The adapter or agent that exported the bundle."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "repo_root": {
      "type": "string",
      "description": "Repository root relative to the bundle producer."
    },
    "git": {
      "type": "object",
      "required": ["branch", "base_ref", "head_sha", "dirty"],
      "additionalProperties": true,
      "properties": {
        "branch": {
          "type": "string"
        },
        "base_ref": {
          "type": "string"
        },
        "head_sha": {
          "type": "string"
        },
        "dirty": {
          "type": "boolean"
        },
        "diff_max_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5000000,
          "description": "Optional byte limit used to capture and later compare diff.patch. Omission means the default 1000000-byte limit."
        },
        "status_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "Optional SHA-256 digest of stable porcelain status bytes, including untracked paths but not untracked file contents."
        },
        "repo_state_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "Optional SHA-256 digest of canonical status, index, and unstaged tracked diff bytes. Only the digest is stored."
        }
      }
    },
    "artifacts": {
      "type": "object",
      "required": ["waybill"],
      "additionalProperties": true,
      "properties": {
        "waybill": {
          "type": "string"
        },
        "diff": {
          "type": "string"
        },
        "commands": {
          "type": "string"
        },
        "test_summary": {
          "type": "string"
        }
      }
    },
    "handoff": {
      "type": "object",
      "description": "Optional handoff semantics for compatible importers.",
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "required": ["kind"],
            "properties": {
              "kind": {
                "const": "delegation_request"
              }
            }
          },
          "then": {
            "required": ["request_id", "parent_agent", "child_agent"]
          }
        },
        {
          "if": {
            "required": ["kind"],
            "properties": {
              "kind": {
                "const": "delegation_result"
              }
            }
          },
          "then": {
            "required": ["result_for", "result_status", "parent_agent", "child_agent"]
          }
        }
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["handoff", "delegation_request", "delegation_result"],
          "description": "Use handoff for ordinary transfers, delegation_request for parent-to-child subtasks, and delegation_result for child-to-parent results."
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "description": "Stable correlation identifier required on a delegation request."
        },
        "result_for": {
          "type": "string",
          "minLength": 1,
          "description": "Request identifier required on a delegation result."
        },
        "result_status": {
          "type": "string",
          "enum": ["completed", "partial", "blocked"],
          "description": "Outcome required on a delegation result."
        },
        "parent_agent": {
          "type": "string",
          "minLength": 1,
          "description": "Optional name of the parent agent role or adapter."
        },
        "child_agent": {
          "type": "string",
          "minLength": 1,
          "description": "Optional name of the child agent role or adapter."
        }
      }
    }
  }
}
